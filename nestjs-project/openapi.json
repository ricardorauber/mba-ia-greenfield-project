    "/videos/{id}/thumbnail": {
      "get": {
        "description": "Redirects to a presigned URL of the JPEG thumbnail generated during processing.",
        "operationId": "VideosController_thumbnail",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to a short-lived presigned storage URL",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "private, no-store"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR — `id` is not a UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND — the video does not exist or belongs to another channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "VIDEO_NOT_READY — the video is not ready or has no thumbnail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get a video thumbnail",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "new_password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "new_password"
        ]
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "file_name": {
            "type": "string",
            "description": "Original file name; its extension (.mp4 / .webm) must match `mime_type`.",
            "minLength": 1,
            "maxLength": 255
          },
          "mime_type": {
            "type": "string",
            "description": "Declared MIME type: `video/mp4` or `video/webm`."
          },
          "size": {
            "type": "number",
            "description": "Declared file size in bytes (at most 10737418240).",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "description": "Video title; defaults to the file name without its extension.",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "file_name",
          "mime_type",
          "size"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "video_codec": {
            "type": "string",
            "example": "h264"
          },
          "audio_codec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "format_name": {
            "type": "string",
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bit_rate": {
            "type": "number",
            "nullable": true,
            "example": 1500000
          },
          "frame_rate": {
            "type": "number",
            "nullable": true,
            "example": 29.97
          }
        },
        "required": [
          "video_codec",
          "audio_codec",
          "format_name",
          "bit_rate",
          "frame_rate"
        ]
      },
      "UploadPlanDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "integer",
            "example": 67108864
          },
          "part_count": {
            "type": "integer",
            "example": 1
          }
        },
        "required": [
          "part_size",
          "part_count"
        ]
      },
      "CreateVideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "description": "Unique 11-character base64url identifier of the video URL",
            "example": "dQw4w9WgXcQ"
          },
          "title": {
            "type": "string",
            "example": "My video"
          },
          "original_filename": {
            "type": "string",
            "example": "my-video.mp4"
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/webm"
            ],
            "example": "video/mp4"
          },
          "status": {
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "type": "string"
          },
          "failure_reason": {
            "type": "string",
            "nullable": true,
            "enum": [
              "upload_abandoned",
              "size_mismatch",
              "unsupported_format",
              "invalid_media",
              "processing_error"
            ]
          },
          "duration": {
            "type": "number",
            "nullable": true,
            "description": "Duration in seconds",
            "example": 12.5
          },
          "width": {
            "type": "integer",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "integer",
            "nullable": true,
            "example": 1080
          },
          "size": {
            "type": "integer",
            "nullable": true,
            "format": "int64",
            "description": "Stored size in bytes"
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "has_thumbnail": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadPlanDto"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "original_filename",
          "mime_type",
          "status",
          "failure_reason",
          "duration",
          "width",
          "height",
          "size",
          "metadata",
          "has_thumbnail",
          "created_at",
          "updated_at",
          "upload"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "description": "Unique 11-character base64url identifier of the video URL",
            "example": "dQw4w9WgXcQ"
          },
          "title": {
            "type": "string",
            "example": "My video"
          },
          "original_filename": {
            "type": "string",
            "example": "my-video.mp4"
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/webm"
            ],
            "example": "video/mp4"
          },
          "status": {
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "type": "string"
          },
          "failure_reason": {
            "type": "string",
            "nullable": true,
            "enum": [
              "upload_abandoned",
              "size_mismatch",
              "unsupported_format",
              "invalid_media",
              "processing_error"
            ]
          },
          "duration": {
            "type": "number",
            "nullable": true,
            "description": "Duration in seconds",
            "example": 12.5
          },
          "width": {
            "type": "integer",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "integer",
            "nullable": true,
            "example": 1080
          },
          "size": {
            "type": "integer",
            "nullable": true,
            "format": "int64",
            "description": "Stored size in bytes"
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "has_thumbnail": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "original_filename",
          "mime_type",
          "status",
          "failure_reason",
          "duration",
          "width",
          "height",
          "size",
          "metadata",
          "has_thumbnail",
          "created_at",
          "updated_at"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "integer",
            "example": 1
          },
          "size": {
            "type": "integer",
            "example": 67108864
          }
        },
        "required": [
          "part_number",
          "size"
        ]
      },
      "UploadStatusResponseDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "integer",
            "example": 67108864
          },
          "part_count": {
            "type": "integer",
            "example": 3
          },
          "uploaded_parts": {
            "description": "Parts already stored, ordered by part_number",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "part_size",
          "part_count",
          "uploaded_parts"
        ]
      },
      "CreatePartUrlsDto": {
        "type": "object",
        "properties": {
          "part_numbers": {
            "description": "Part numbers to sign: 1..100 unique integers, each within the upload's part_count.",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "required": [
          "part_numbers"
        ]
      },
      "PartUrlDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "integer",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned URL: PUT the part bytes here, without auth headers",
            "example": "http://localhost:9000/streamtube-videos/videos/{id}/original?partNumber=1&uploadId=..."
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "PartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "expires_in": {
            "type": "integer",
            "description": "Seconds the URLs stay valid",
            "example": 3600
          },
          "parts": {
            "description": "In the same order as the requested part_numbers",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlDto"
            }
          }
        },
        "required": [
          "expires_in",
          "parts"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}